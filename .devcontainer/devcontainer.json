// Единое окружение разработки: одинаковое на Windows, macOS, Linux и в GitHub Codespaces.
// Локально нужен Docker Desktop и VS Code с расширением Dev Containers → «Reopen in Container».
{
  "name": "hackathon",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",

  // Монтируем родительскую папку, чтобы соседние репозитории тоже были доступны в контейнере
  // (в Codespaces эти две настройки игнорируются).
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // node_modules и кэш pnpm — в томах Docker: на Windows это в разы быстрее, чем через общую папку.
  "mounts": [
    "source=hackathon-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=hackathon-web-node_modules,target=${containerWorkspaceFolder}/apps/web/node_modules,type=volume",
    "source=hackathon-pnpm-store,target=/home/node/.local/share/pnpm,type=volume"
  ],

  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends jq && sudo chown -R node:node node_modules apps/web/node_modules /home/node/.local/share/pnpm",
  "postCreateCommand": "bash scripts/setup.sh",

  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "web", "onAutoForward": "openBrowser" } },

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer",
        "ms-playwright.playwright",
        "editorconfig.editorconfig",
        "github.vscode-pull-request-github",
        "ms-dotnettools.csdevkit"
      ]
    }
  },

  "remoteUser": "node"
}
